{
  "name": "@hightex/scanner",
  "version": "0.1.0",
  "private": true,
  "description": "Runtime-independent HighTex document validation engine",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/sync-version.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test ./tests",
    "prepack": "npm run build",
    "release:version": "npm version --no-git-tag-version",
    "preversion": "npm run typecheck && npm test",
    "version": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/bun": "^1.3.14"
  }
}
